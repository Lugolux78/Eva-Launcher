    </PartText>
    <PartText x="92" y="361" width="92" height="30">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="23" color="#FFFFFF">
        <Template>%d<Parameter expression="round([HEART_RATE])"/></Template>
      </Font></Text>
      <Launch target="HEALTH_HEART_RATE"/>
    </PartText>
