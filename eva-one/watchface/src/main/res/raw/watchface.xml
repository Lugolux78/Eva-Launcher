      <Arc centerX="312" centerY="369" width="90" height="90" startAngle="315" endAngle="145">
        <Stroke color="#19D88C" thickness="5" cap="ROUND"/>
      </Arc>
    </PartDraw>
    <PartText x="100" y="70" width="250" height="32">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="19" color="#D4EBE2">
        <Template>%s %d %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/></Template>
      </Font></Text>
    </PartText>
    <DigitalClock x="30" y="113" width="390" height="92">
      <TimeText x="0" y="0" width="390" height="92" format="hh:mm" hourFormat="24" align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="79" weight="BOLD" color="#FFFFFF"/>
      </TimeText>
    </DigitalClock>
    <PartText x="92" y="265" width="92" height="29">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="23" color="#FFFFFF">
        <Template>%d%%<Parameter expression="[BATTERY_PERCENT]"/></Template>
      </Font></Text>
      <Launch target="BATTERY_STATUS"/>
    </PartText>
    <PartText x="264" y="265" width="96" height="29">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="22" color="#FFFFFF">
        <Template>%d<Parameter expression="[STEP_COUNT]"/></Template>
